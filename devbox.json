{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.10.5/.schema/devbox.schema.json",
  "packages": [
    "python@3.11",
    "poetry@latest",
    "tmux@latest",
    "gitmux@latest",
    "git-secret@latest",
    "tmuxinator@latest",
    "gnumake@latest",
    "pre-commit@latest",
    "hadolint@latest",
    "shellcheck@latest",
    "ruff@latest",
    "skjold@latest",
    "nodejs@latest",
    "python311Packages.autopep8@latest",
    "python311Packages.bandit@latest",
    "python311Packages.reorder-python-imports@latest",
    "python311Packages.pyroma@latest",
    "python311Packages.pytest@latest",
    "python311Packages.twine@latest",
    "nodePackages.nodemon@latest",
    "python311Packages.python-dotenv@latest"
  ],
  "env": {
    "DEVBOX_COREPACK_ENABLED": "true",
    "PYTHONPATH":              ".:.venv/lib/python3.11/site-packages:$PYTHONPATH"
  },
  "shell": {
    "init_hook": [
      "poetry shell",
      "dotenv",
      "pre-commit install -f"
    ],
    "scripts": {}
  }
}
